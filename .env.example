# Environment Configuration
# Copy this file to .env and update values for your environment

# Application Environment (development, testing, production)
APP_ENV=development

# Debug Mode (NEVER enable in production)
DEBUG=False

# Secret Key (MUST change in production - use strong random string)
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-this-to-secure-random-string-in-production

# OpenAI API Key (REQUIRED for all LLM nodes)
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_CODEX_ENABLED=false

# v0.7 usage ceilings: 20,000 tokens / US$1 per job or synchronous operation.
# Set verified pricing for the exact model before enabling paid calls.
# Cost is calculated from provider-reported tokens, not an invoice measurement.
PRICED_MODEL=
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
# APP_RUNTIME_DIR=data/runtime

# Flask Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# Logging Configuration
LOG_LEVEL=INFO

# Security Configuration
ENABLE_AUTH=False
# Named local accounts are provisioned with flask create-account; no public registration.
# Login activation is on hold. False is localhost-only development, never public hosting.
JWT_SECRET_KEY=change-this-jwt-secret-in-production
ENABLE_RATE_LIMITING=True

# Performance Configuration
ENABLE_CACHING=True
CACHE_TYPE=simple

# Redis Configuration (if using Redis cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Database Configuration (future use)
DATABASE_URL=sqlite:///langraph.db

# CORS Configuration
CORS_ORIGINS=*

# Feature Flags
ENABLE_ASYNC=False
ENABLE_METRICS=False

# Guard Rail Configuration
STRICT_MODE=True

# Stripe hosted Checkout (Apple Pay is presented automatically when eligible).
# STRIPE_API_KEY is accepted as a legacy alias for STRIPE_SECRET_KEY.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ENABLED=false
BILLING_ALLOW_LIVE=false
BILLING_PUBLIC_URL=http://localhost:5001
# Sandbox plan approved for testing: $29/month, $10 execution allowance.
STRIPE_MEMBERSHIP_AMOUNT_CENTS=2900
STRIPE_MEMBERSHIP_CREDITS_CENTS=1000
# Monthly included credits expire; purchased top-ups do not.
API_JOB_MAX_COST_USD=5
API_JOB_MAX_TOKENS=100000
